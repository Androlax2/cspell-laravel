{
  "name": "@androlax2/cspell-laravel",
  "version": "1.0.0",
  "description": "Laravel dictionary for cspell.",
  "author": "Théo Benoit <theo.benoit16@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Androlax2/cspell-laravel",
    "directory": "dictionaries/software-terms"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./cspell-ext.json",
